[Unit]
Description=Custom Script Service
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=ubuntu  # Change to your user
Group=ubuntu  # Change to your group
WorkingDirectory=/opt/services/custom-scripts

# If your script needs to interact with Docker:
ExecStart=/opt/services/custom-scripts/custom-script.sh

# If your script is a Python script:
# ExecStart=/usr/bin/python3 /opt/services/custom-scripts/custom-script.py

# If your script needs environment variables:
Environment="VARIABLE1=value1"
Environment="VARIABLE2=value2"
# Or use EnvironmentFile:
# EnvironmentFile=/opt/services/custom-scripts/.env

Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=custom-script

[Install]
WantedBy=multi-user.target

# Installation instructions:
# 1. Copy this file to /etc/systemd/system/custom-script.service
# 2. sudo systemctl daemon-reload
# 3. sudo systemctl enable custom-script
# 4. sudo systemctl start custom-script
# 5. Check status: sudo systemctl status custom-script
# 6. View logs: sudo journalctl -u custom-script -f
